# Copy this file to .env and replace the local values.
FRONTEND_PORT=8080
API_PORT=8001
ADMINER_PORT=8081

POSTGRES_DB=documents
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-this-local-password

# Required only for AI summarization. Never commit the real key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
MAX_UPLOAD_MB=5
